{
  "name": "mirafold-desktop",
  "productName": "Mirafold",
  "desktopName": "mirafold.desktop",
  "version": "0.3.4",
  "private": true,
  "description": "Mirafold as a desktop app — no terminal, no Node, no npm.",
  "license": "MIT",
  "author": "Kyle Serrecchia (https://github.com/kserrec)",
  "homepage": "https://mirafold.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirafold/mirafold-desktop.git"
  },
  "type": "module",
  "main": "src/main.js",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@12.0.2",
  "scripts": {
    "start": "electron .",
    "start:nosandbox": "electron . --no-sandbox",
    "node-version": "ELECTRON_RUN_AS_NODE=1 electron -e \"console.log(process.versions.node)\"",
    "release:prepare": "node scripts/prepare-shell-release.mjs",
    "release:rehearse": "node scripts/release-rehearsal.mjs",
    "update:probe:linux": "node scripts/linux-update-probe.mjs",
    "test": "node --test \"test/*.test.js\"",
    "pack": "electron-builder --dir",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "mirafold": "0.6.1"
  },
  "devDependencies": {
    "@noble/hashes": "2.3.0",
    "electron": "43.4.0",
    "electron-builder": "26.15.3"
  }
}
