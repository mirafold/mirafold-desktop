{
  "name": "mirafold-desktop",
  "productName": "Mirafold",
  "version": "0.1.1",
  "private": true,
  "description": "Mirafold as a desktop app — no terminal, no Node, no npm.",
  "license": "MIT",
  "author": "Kyle Serrecchia (https://github.com/kserrec)",
  "homepage": "https://mirafold.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirafold/mirafold-desktop.git"
  },
  "type": "module",
  "main": "src/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "start:nosandbox": "electron . --no-sandbox",
    "node-version": "ELECTRON_RUN_AS_NODE=1 electron -e \"console.log(process.versions.node)\"",
    "test": "node --test \"test/*.test.js\"",
    "pack": "electron-builder --dir",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "mirafold": "^0.3.0"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  }
}
